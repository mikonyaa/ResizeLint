{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikonyaa/ResizeLint/blob/v1/Schemas/resizelint-baseline-v2.schema.json",
  "title": "ResizeLint baseline v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "findings",
    "fingerprintVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "toolVersion": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleID",
          "path",
          "fingerprint",
          "occurrences"
        ],
        "properties": {
          "ruleID": {
            "type": "string",
            "pattern": "^RL00[1-9]$"
          },
          "path": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:"
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "fingerprintVersion": {
      "const": 2
    }
  }
}
